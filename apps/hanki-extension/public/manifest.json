{
  "manifest_version": 3,
  "name": "한끼",
  "version": "0.1.0",
  "description": "요기요 메뉴 추천과 장바구니 담기 에이전트",
  "key": "",
  "permissions": [
    "debugger",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.yogiyo.co.kr/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "한끼"
  }
}
